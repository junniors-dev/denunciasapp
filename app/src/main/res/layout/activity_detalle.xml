<?xml version="1.0" encoding="utf-8"?>
<!-- el FrameLayout deja espacio a las barras del sistema; el LinearLayout lleva el margen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/borde">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cargando…"
                        android:textColor="@color/texto"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/fondo_estado"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="invisible" />
                </LinearLayout>

                <TextView
                    style="@style/Etiqueta"
                    android:text="DNI del ciudadano" />

                <TextView
                    android:id="@+id/txtDni"
                    style="@style/Valor" />

                <TextView
                    style="@style/Etiqueta"
                    android:text="Fecha" />

                <TextView
                    android:id="@+id/txtFecha"
                    style="@style/Valor" />

                <TextView
                    style="@style/Etiqueta"
                    android:text="Dirección" />

                <TextView
                    android:id="@+id/txtDireccion"
                    style="@style/Valor" />

                <TextView
                    style="@style/Etiqueta"
                    android:text="Descripción" />

                <TextView
                    android:id="@+id/txtDescripcion"
                    style="@style/Valor" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Atender denuncia"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver a la lista"
            app:icon="@drawable/ic_back"
            app:iconGravity="textStart" />
    </LinearLayout>
</FrameLayout>
