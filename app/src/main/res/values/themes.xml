<resources>
    <style name="Theme.Denuncias" parent="Theme.Material3.Light">
        <item name="colorPrimary">#1D4ED8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DBEAFE</item>
        <item name="colorOnPrimaryContainer">#1E3A8A</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <!-- Etiqueta y valor de cada dato en el detalle -->
    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gris</item>
    </style>

    <style name="Valor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/texto</item>
    </style>
</resources>
